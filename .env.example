# Ambiente integrado isolado. Não use o nome do ambiente principal.
COMPOSE_PROJECT_NAME=solo-ibiapaba-integrado
POSTGRES_DB=solo_ibiapaba
POSTGRES_USER=solo_app
# Gere .env com: python3 scripts/configurar.py
POSTGRES_PASSWORD=
# Só utilizado com compose.database-port.yaml.
POSTGRES_PORT=5434
BACKEND_PORT=8090
FRONTEND_PORT=3010

# Vazio: Compose calcula http://localhost:<BACKEND_PORT>/api no build.
# URL vista pelo navegador. Não use http://backend:8080/api aqui.
NEXT_PUBLIC_API_URL=
# Vazio: permite localhost e 127.0.0.1 na FRONTEND_PORT configurada.
CORS_ALLOWED_ORIGIN_PATTERNS=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@soloibiapaba.com
ADMIN_PASSWORD=
